{
  "name": "@graphtoy/monorepo",
  "version": "1.0.0",
  "description": "GraphToy monorepo containing core library and examples",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "pnpm -r test",
    "test:ui": "pnpm -r test:ui",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "clean": "pnpm -r clean",
    "example": "pnpm --filter @graphtoy/example dev"
  },
  "keywords": [
    "graphing",
    "mathematics",
    "visualization",
    "canvas",
    "functions",
    "real-time",
    "typescript",
    "monorepo"
  ],
  "author": "GraphToy Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}
